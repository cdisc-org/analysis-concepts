{
  "$schema": "../../model/method/acdc_methods.schema.json",
  "schema_version": "0.8.0",
  "$vocabulary": {
    "statistics": "../../model/method/statistics_vocabulary.json",
    "output_classes": "../../model/method/output_class_templates.json",
    "formula_grammar": "../../model/method/formula_grammar.json"
  },
  "oid": "M.KaplanMeier",
  "name": "Kaplan-Meier Estimator",
  "type": "analysis",
  "class": "Survival Models",
  "intent": [
    "TimeToEventEstimate"
  ],
  "description": "Non-parametric survival function estimation with optional grouping",
  "formula": {
    "notation": "survival",
    "default_expression": "Surv(time, event) ~ group",
    "generic_expression": "Surv(<time>, <event>) ~ <group>?",
    "notes": "If no group is specified, estimates a single survival curve. With a group variable, produces stratified curves."
  },
  "configurations": [
    {
      "name": "conf_type",
      "dataType": "enum",
      "defaultValue": "log-log",
      "enumValues": [
        "log-log",
        "log",
        "plain",
        "arcsin"
      ],
      "description": "Confidence interval transformation type"
    },
    {
      "name": "event_indicator",
      "dataType": "enum",
      "defaultValue": "censor_1",
      "enumValues": [
        "censor_1",
        "event_1"
      ],
      "description": "Polarity of the event role. 'censor_1' reads ADaM CNSR (1 = censored, 0 = event observed); 'event_1' reads the opposite convention (1 = event observed)."
    }
  ],
  "output_specification": {
    "output_classes": [
      {
        "class": "event_summary",
        "description": "Summary of events and censoring per group",
        "dimensions": [
          "group"
        ],
        "statistics": [
          "n_risk",
          "n_event",
          "n_censored"
        ]
      },
      {
        "class": "survival_table",
        "description": "Life table with survival estimates at each event time",
        "dimensions": [
          "group",
          "time"
        ],
        "statistics": [
          "n_risk",
          "n_event",
          "n_censored",
          "survival_prob",
          "SE",
          "CI_lower",
          "CI_upper"
        ]
      },
      {
        "class": "median_survival",
        "description": "Median survival time per group with confidence interval",
        "dimensions": [
          "group"
        ],
        "statistics": [
          "median",
          "CI_lower",
          "CI_upper"
        ]
      },
      {
        "class": "landmark_estimates",
        "description": "Survival probability at specific landmark times",
        "dimensions": [
          "group",
          "time"
        ],
        "statistics": [
          "survival_prob",
          "SE",
          "CI_lower",
          "CI_upper"
        ]
      }
    ]
  },
  "assumptions": [
    "Non-informative censoring",
    "Independence of survival times"
  ],
  "input_roles": [
    {
      "name": "time",
      "statisticalRole": "response",
      "dataType": "decimal",
      "required": true,
      "cardinality": "single",
      "description": "Time to event or censoring"
    },
    {
      "name": "event",
      "statisticalRole": "response",
      "dataType": "boolean",
      "required": true,
      "cardinality": "single",
      "description": "Event indicator (1=event, 0=censored)"
    },
    {
      "name": "group",
      "statisticalRole": "group",
      "dataType": "code",
      "required": false,
      "cardinality": "single",
      "description": "The factor whose levels are estimated separately for \u2014 typically treatment. Not a fixed effect: this method fits no model, so there is no effect to estimate."
    }
  ]
}
