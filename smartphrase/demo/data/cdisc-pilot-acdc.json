      "iri": "acdc:instance/AC-PRIMARY-ADASCOG",
      "sentence": [
        { "sp": "SP_CFB_ENDPOINT",     "role": "endpoint",         "bindings": { "parameter":  { "conceptId": "PARAM.ADASCOG11", "render": "long_with_short" } } },
        { "sp": "SP_TIMEPOINT",         "role": "timepoint",        "bindings": { "visit":      { "conceptId": "VISIT.WK24",     "render": "short" } } },
