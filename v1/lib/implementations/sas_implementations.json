    {
      "method": "M.PairedTTest",
      "language": "SAS",
      "package": "SAS/STAT",
      "procedure": "PROC TTEST",
      "callTemplate": "proc ttest data=<dataset> alpha=<alpha>;\n  paired <response>*<fixed_effect>;\nrun;",
      "outputMapping": [
        {
          "producer": "SM.PairedTTest.TTestResult",
          "sourceName": "test_result",
          "resultColumns": [
            {
              "name": "estimate",
              "statistic": "S.estimate",
              "column": "Statistics.Mean"
            },
            {
              "name": "t_statistic",
              "statistic": "S.t_statistic",
              "column": "TTests.tValue"
            },
            {
              "name": "df",
              "statistic": "S.df",
              "column": "TTests.DF"
            },
            {
              "name": "p_value",
              "statistic": "S.p_value",
              "column": "TTests.Probt"
            },
            {
              "name": "CI_lower",
              "statistic": "S.CI_lower",
              "column": "ConfLimits.LowerCLMean"
            },
            {
              "name": "CI_upper",
              "statistic": "S.CI_upper",
              "column": "ConfLimits.UpperCLMean"
            }
          ]
        }
      ],
      "documentation": "https://documentation.sas.com/doc/en/statug/15.2/statug_ttest_overview.htm",
      "notes": "PROC TTEST with PAIRED statement. The PAIRED statement expects var1*var2 syntax where var1 and var2 are the two measurement variables. ODS tables: Statistics, TTests, ConfLimits."
    },
