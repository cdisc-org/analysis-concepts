{
  "conceptId": "M.Sum",
  "name": "Sum",
  "label": "Sum",
  "description": "Computes the sum of all values of a numeric variable",
  "status": "released",
  "methodType": "AggregationMethod",
  "inputs": [
    {
      "inputType": "ContinuousVariable",
      "role": "value",
      "description": "The variable to summarize",
      "dataType": "decimal",
      "required": true,
      "multivalued": false
    },
    {
      "inputType": "CategoricalVariable",
      "role": "group",
      "description": "Optional grouping variable(s)",
      "dataType": "code",
      "required": false,
      "multivalued": true,
      "levels": [
        {
          "name": "group_level",
          "description": "A level of the group variable"
        }
      ]
    }
  ],
  "formula": {
    "notation": "aggregation",
    "text": "result := SUM(<value>) OVER (<group>*)",
    "defaultExpression": "result := SUM(value) OVER (group)"
  },
  "output": {
    "outputClass": "OC.computed_value",
    "statisticSets": [
      "SS.computed_value"
    ],
    "dataType": "decimal"
  }
}
