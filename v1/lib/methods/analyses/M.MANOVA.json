{
  "conceptId": "M.MANOVA",
  "name": "Multivariate Analysis of Variance",
  "label": "MANOVA",
  "description": "Tests the hypothesis of no overall treatment effect across multiple correlated response variables simultaneously",
  "codings": [
    {
      "system": "http://purl.obolibrary.org/obo/stato",
      "code": "STATO_0000454",
      "display": "multivariate analysis of variance"
    }
  ],
  "status": "released",
  "methodType": "ModelBasedMethod",
  "configurations": [
    {
      "name": "test_statistic",
      "description": "Multivariate test statistic",
      "dataType": "code",
      "defaultValue": "wilks",
      "enumValues": [
        "wilks",
        "pillai",
        "hotelling_lawley",
        "roy"
      ]
    },
    {
      "name": "covariance_structure",
      "description": "Covariance structure among responses",
      "dataType": "code",
      "defaultValue": "UN",
      "enumValues": [
        "UN",
        "CS",
        "AR1"
      ]
    }
  ],
  "inputs": [
    {
      "inputType": "ContinuousVariable",
      "role": "response",
      "description": "Multiple correlated response variables",
      "dataType": "decimal",
      "required": true,
      "multivalued": true
    },
    {
      "inputType": "CategoricalVariable",
      "role": "fixed_effect",
      "description": "Treatment/factor variable(s)",
      "dataType": "code",
      "required": true,
      "multivalued": true,
      "levels": [
        {
          "name": "fixed_effect_level",
          "description": "A level of the fixed_effect variable"
        }
      ]
    },
    {
      "inputType": "CategoricalVariable",
      "role": "repeated_subject",
      "description": "Subject identifier",
      "dataType": "id",
      "required": true,
      "multivalued": false,
      "levels": [
        {
          "name": "repeated_subject_level",
          "description": "A level of the repeated_subject variable"
        }
      ]
    },
    {
      "inputType": "CategoricalVariable",
      "role": "repeated_factor",
      "description": "Parameter/subscale identifier (defines which response variable)",
      "dataType": "code",
      "required": true,
      "multivalued": false,
      "levels": [
        {
          "name": "repeated_factor_level",
          "description": "A level of the repeated_factor variable"
        }
      ]
    },
    {
      "inputType": "ContinuousVariable",
      "role": "covariate",
      "description": "Continuous covariate(s) for adjustment.",
      "dataType": "decimal",
      "required": false,
      "multivalued": true
    }
  ],
  "statisticalModel": {
    "name": "MANOVA model",
    "description": "Left-hand side uses cbind() to specify the multivariate response. In long format with a parameter identifier, the model is fit as response ~ group with subject and parameter defining the multivariate structure.",
    "formula": {
      "notation": "wilkinson_rogers",
      "text": "cbind(<response>+) ~ <covariate>* + <fixed_effect>+",
      "defaultExpression": "cbind(response1, response2, ...) ~ fixed_effect"
    },
    "isModelFor": [
      "response"
    ],
    "modelTerms": [
      {
        "name": "covariate",
        "description": "Main effect of covariate",
        "forInputs": [
          "covariate"
        ],
        "parameters": [
          {
            "name": "covariate_coefficient",
            "description": "Regression coefficient for covariate",
            "forInputVariables": [
              "covariate"
            ]
          }
        ]
      },
      {
        "name": "fixed_effect",
        "description": "Main effect of fixed_effect",
        "forInputs": [
          "fixed_effect"
        ],
        "parameters": [
          {
            "name": "fixed_effect_effect",
            "description": "Effect of a level of fixed_effect",
            "forFactorLevels": [
              "fixed_effect_level"
            ]
          }
        ]
      }
    ]
  },
  "subMethods": [
    {
      "conceptId": "SM.MANOVA.MultivariateTests",
      "name": "Multivariate tests",
      "description": "Multivariate test statistics for overall hypothesis (Wilks, Pillai, Hotelling-Lawley, Roy). Tests: wilks_lambda, pillai_trace, hotelling_lawley_trace, roy_greatest_root.",
      "methodType": "SubMethod",
      "output": {
        "outputClass": "OC.multivariate_tests",
        "statisticSets": [
          "SS.hypothesis_test_F_distribution"
        ],
        "statistics": [
          "S.estimate"
        ]
      }
    },
    {
      "conceptId": "SM.MANOVA.Type3TestsMixed",
      "name": "Type III F-tests (mixed/multivariate)",
      "description": "Type III F-tests for mixed and multivariate models (no SS/MS exposure).",
      "methodType": "SubMethod",
      "output": {
        "outputClass": "OC.type3_tests_mixed",
        "statisticSets": [
          "SS.hypothesis_test_F_distribution"
        ],
        "forModelTerms": [
          "covariate",
          "fixed_effect"
        ]
      }
    },
    {
      "conceptId": "SM.MANOVA.ParameterEstimatesLinear",
      "name": "Linear-model parameter estimates",
      "description": "Linear-model coefficients with t-based inference.",
      "methodType": "SubMethod",
      "output": {
        "outputClass": "OC.parameter_estimates_linear",
        "statisticSets": [
          "SS.ci_estimate_t_distribution",
          "SS.hypothesis_test_t_distribution"
        ],
        "statistics": [
          "S.coefficient"
        ],
        "forModelParameters": [
          "covariate_coefficient",
          "fixed_effect_effect"
        ]
      }
    }
  ]
}
