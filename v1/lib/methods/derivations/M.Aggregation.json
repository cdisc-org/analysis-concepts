{
  "conceptId": "M.Aggregation",
  "name": "Aggregation",
  "label": "Aggregation",
  "description": "Aggregates values within a partition using specified function",
  "status": "released",
  "methodType": "DerivationMethod",
  "configurations": [
    {
      "name": "agg_func",
      "description": "Aggregation function to apply",
      "dataType": "code",
      "defaultValue": "mean",
      "enumValues": [
        "sum",
        "mean",
        "median",
        "min",
        "max",
        "count",
        "first",
        "last"
      ]
    }
  ],
  "inputs": [
    {
      "inputType": "ContinuousVariable",
      "role": "value",
      "description": "Values to aggregate",
      "dataType": "decimal",
      "required": true,
      "multivalued": false
    },
    {
      "inputType": "CategoricalVariable",
      "role": "partition",
      "description": "Grouping variables defining the partition",
      "dataType": "code",
      "required": true,
      "multivalued": true,
      "levels": [
        {
          "name": "partition_level",
          "description": "A level of the partition variable"
        }
      ]
    }
  ],
  "formula": {
    "notation": "derivation",
    "text": "result := <agg_func>(<value>) OVER (<partition>+)",
    "defaultExpression": "result := AGG(value) OVER (partition)"
  },
  "output": {
    "outputClass": "OC.computed_value",
    "statisticSets": [
      "SS.computed_value"
    ],
    "dataType": "decimal"
  }
}
